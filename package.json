{
  "name": "@coveragemap/speed-transport",
  "version": "0.1.0",
  "description": "Raw TCP, WebSocket, and secure WebSocket on one port, with minimal CPU per byte, for the CoverageMap speed test protocol",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc --watch -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "bench": "npm run build && node bench/run.mjs",
    "autobahn": "npm run build && node autobahn/run.mjs",
    "prepublishOnly": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "keywords": [
    "websocket",
    "tcp",
    "tls",
    "speed-test",
    "throughput",
    "coveragemap",
    "multiplexer",
    "single-port"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/CoverageMapLLC/speed-transport.git"
  },
  "bugs": {
    "url": "https://github.com/CoverageMapLLC/speed-transport/issues"
  },
  "homepage": "https://github.com/CoverageMapLLC/speed-transport#readme",
  "author": "CoverageMap",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^3.2.7",
    "bufferutil": "^4.1.0",
    "eslint": "^9.39.5",
    "selfsigned": "^5.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7",
    "ws": "^8.22.0"
  }
}
